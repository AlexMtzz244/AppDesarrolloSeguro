{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": "./src",
    "outDir": "./dist",
    "types": ["node"],
    // NestJS construye objetos por reflexion; `strictPropertyInitialization`
    // choca con las propiedades que inyecta el framework.
    "strictPropertyInitialization": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "test", "prisma", "scripts"]
}
