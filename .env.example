# =============================================================================
# SecureCampus — plantilla de variables de entorno
# =============================================================================
# RNFS-052. Este archivo se versiona; el .env real NUNCA.
#
# Todos los valores van VACIOS a proposito. La aplicacion valida este conjunto
# con Zod al arrancar y FALLA RUIDOSAMENTE si falta una variable critica, en vez
# de tomar un valor por defecto silencioso. Ese fallo es deliberado: es el
# control de la fase Diseno del escenario B de SC-LAB-002.
#
# Para generar los secretos locales:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# =============================================================================

# --- Entorno ---------------------------------------------------------------
NODE_ENV=development
# Bloquea el arranque en produccion con datos semilla presentes (RNFS-058).
PERMITIR_DATOS_SEMILLA=true

# --- Base de datos ---------------------------------------------------------
POSTGRES_DB=securecampus
POSTGRES_USER=securecampus_owner
POSTGRES_PASSWORD=
# Rol de aplicacion: SIN permiso de UPDATE/DELETE sobre la bitacora (RNFS-031).
POSTGRES_APP_USER=securecampus_app
POSTGRES_APP_PASSWORD=
# La aplicacion se conecta con el rol restringido...
DATABASE_URL=
# ...y las migraciones con el rol propietario. Son credenciales distintas a
# proposito: si la app pudiera migrar, podria tambien revertir el REVOKE que
# protege la bitacora (RNFS-031).
DATABASE_URL_MIGRACIONES=

# --- Redis (sesiones, rate limiting, colas BullMQ) -------------------------
REDIS_URL=

# --- Almacenamiento privado compatible con S3 (MinIO en desarrollo) --------
# RNFS-040: bucket PRIVADO. Nunca una ruta estatica publica.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_DOCUMENTOS=securecampus-documentos
S3_BUCKET_CUARENTENA=securecampus-cuarentena
S3_FORCE_PATH_STYLE=true

# --- Antivirus (ClamAV) ----------------------------------------------------
CLAMAV_HOST=
CLAMAV_PORT=3310

# --- Correo (Mailpit en desarrollo) ----------------------------------------
SMTP_HOST=
SMTP_PORT=1025
SMTP_FROM=no-reply@securecampus.edu.mx

# --- Secretos de aplicacion ------------------------------------------------
# 32 bytes en base64 cada uno. Distintos por ambiente (RNFS-057).
SESION_SECRETO_FIRMA=
# Cifra el secreto TOTP en reposo (RNFS-017).
MFA_CLAVE_CIFRADO=

# --- Politica de sesion (RNFS-012, RNFS-013) -------------------------------
SESION_COOKIE_NOMBRE=sc_sesion
SESION_INACTIVIDAD_MINUTOS=30
SESION_DURACION_MAXIMA_HORAS=12
# En produccion debe ser true sin excepcion.
SESION_COOKIE_SECURE=false

# --- Hashing de contrasenas (RNFS-010) -------------------------------------
ARGON2_MEMORIA_KIB=19456
ARGON2_ITERACIONES=2
ARGON2_PARALELISMO=1

# --- Rate limiting (D-05, parametrizable) ----------------------------------
LOGIN_MAX_INTENTOS_CUENTA=5
LOGIN_MAX_INTENTOS_IP=20
LOGIN_VENTANA_MINUTOS=15
LOGIN_RETARDO_BASE_MS=250
LOGIN_UMBRAL_CAPTCHA=3
# Piso de latencia uniforme para no filtrar por tiempo si la cuenta existe
# (RNFS-016).
LOGIN_LATENCIA_MINIMA_MS=400
CAPTCHA_PROVEEDOR=ninguno
CAPTCHA_SECRETO=

# --- Recuperacion de cuenta (RF-010 reescrito, RNFS-022) -------------------
RECUPERACION_VIGENCIA_MINUTOS=20
RECUPERACION_MAX_SOLICITUDES_HORA=3

# --- Documentos (D-04, parametrizable) -------------------------------------
DOCUMENTO_TAMANO_MAXIMO_MB=10
DOCUMENTO_CUOTA_USUARIO_MB=100
DOCUMENTO_TIPOS_PERMITIDOS=application/pdf,image/jpeg,image/png

# --- Alertas y anomalias (D-05) --------------------------------------------
ALERTA_UMBRAL_403_POR_MINUTO=10
ALERTA_UMBRAL_DESCARGAS_POR_HORA=25
ALERTA_MINUTOS_CAPTURA_INMEDIATA=60
ALERTA_MINUTOS_REVERSION_SOSPECHOSA=120

# --- Red y CORS (RNFS-051) -------------------------------------------------
API_PUERTO=3001
WEB_PUERTO=3000
CORS_ORIGENES_PERMITIDOS=http://localhost:3000
# Numero de proxies de confianza. Sin esto la IP real se pierde y el limite por
# origen es inutil (SC-LAB-002 escenario D, fase Despliegue).
TRUST_PROXY_SALTOS=1

# --- Observabilidad --------------------------------------------------------
LOG_NIVEL=info
OTEL_HABILITADO=false
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Frontend --------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001
